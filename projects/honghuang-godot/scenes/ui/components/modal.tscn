[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://assets/ui-foundation/foundation.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/ui/modal.gd" id="script"]

[node name="Modal" type="Control"]
theme = ExtResource("theme")
metadata/ui_foundation = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")
mouse_filter = 0


[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0,0.05,0.04,0.7)


[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2


[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(450,320)


[node name="Content" type="VBoxContainer" parent="Center/Panel"]


[node name="Header" type="HBoxContainer" parent="Center/Panel/Content"]


[node name="Title" type="Label" parent="Center/Panel/Content/Header"]
size_flags_horizontal = 3
text = "提示"
theme_override_font_sizes/font_size = 30
mouse_filter = 2


[node name="Close" type="Button" parent="Center/Panel/Content/Header"]
text = "×"


[node name="Body" type="VBoxContainer" parent="Center/Panel/Content"]
size_flags_vertical = 3


[node name="Actions" type="HBoxContainer" parent="Center/Panel/Content"]


[node name="Cancel" type="Button" parent="Center/Panel/Content/Actions"]
text = "取消"
size_flags_horizontal = 3


[node name="Confirm" type="Button" parent="Center/Panel/Content/Actions"]
text = "确认"
size_flags_horizontal = 3

