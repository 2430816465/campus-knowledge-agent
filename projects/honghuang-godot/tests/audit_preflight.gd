extends SceneTree
var checks := 0
var failures: Array = []
var observations: Array = []
var audit_phase := "preaudit"
func check(condition: bool, label: String) -> void:
	checks += 1
	if not condition:
		failures.append(label)
		push_error("PRE-AUDIT: " + label)
func _write(path: String, value: String) -> void:
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(value)
	file.close()
func _initialize() -> void:
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--audit-phase="): audit_phase=arg.trim_prefix("--audit-phase=")
	var dir := "user://tests/independent-audit-%d" % Time.get_ticks_usec()
	var a := GameStore.new(dir)
	check(a.load_slot().ok, "create isolated normal save")
	var export_path := dir.path_join("original.json")
	check(a.export_save(export_path).ok, "export initial exact save")
	var stale_revision := int(a.state.revision)
	a.release()
	var b := GameStore.new(dir)
	check(b.load_slot().ok, "second owner load")
	check(b.transact("claimMail", {"id":"godot-welcome-1"}).ok, "second owner commits new assets")
	var latest := b.state.duplicate(true)
	b.release()
	var import_result := a.import_save(export_path)
	check(not import_result.ok, "stale owner import must not silently overwrite newer disk revision")
	observations.append({"case":"stale_save_import", "stale_revision":stale_revision, "latest_revision":latest.revision, "result":import_result, "latest_reward_preserved":GameStore.decode_save(FileAccess.get_file_as_string(a._path)).get("data",{}).get("claimedMail",[]).has("godot-welcome-1")})
	check(GameStore.decode_save(FileAccess.get_file_as_string(a._path)).data.resources == latest.resources and GameStore.decode_save(FileAccess.get_file_as_string(a._path)).data.claimedMail == latest.claimedMail, "rejected stale import preserves newer actual disk state")
	a.release()
	var service := GameOnlineMock.new(dir.path_join("service.json"), "normal")
	check(service.command("audit_a", "device_a", "login").ok, "mock login")
	var one := GameStore.new(dir)
	check(one.load_mock_profile("normal", "audit_a", "device_a").ok, "mock account load")
	var upload := service.command("audit_a", "device_a", "cloud_upload", {"save":one.state.duplicate(true), "expected_revision":0})
	check(upload.ok, "upload exact cloud")
	one.release()
	var two := GameStore.new(dir)
	check(two.load_mock_profile("normal", "audit_a", "device_a").ok, "mock second owner")
	check(two.transact("claimMail", {"id":"godot-welcome-1"}).ok, "mock second owner commits")
	latest = two.state.duplicate(true)
	two.release()
	var cloud_import := one.import_mock_state(upload.data, int(one.state.revision))
	check(not cloud_import.ok, "stale owner cloud import must compare disk revision before replacement")
	observations.append({"case":"stale_cloud_import", "result":cloud_import, "latest_revision":latest.revision, "latest_reward_preserved":GameStore.decode_save(FileAccess.get_file_as_string(one._path)).get("data",{}).get("claimedMail",[]).has("godot-welcome-1")})
	check(GameStore.decode_save(FileAccess.get_file_as_string(one._path)).data.resources == latest.resources and GameStore.decode_save(FileAccess.get_file_as_string(one._path)).data.claimedMail == latest.claimedMail, "rejected cloud import preserves newer actual disk state")
	one.release()
	_demo_clock_and_account_import(dir)
	var normal := GameStore.new(dir + "-corrupt")
	check(normal.load_slot().ok, "corrupt test initial")
	check(normal.transact("claimMail", {"id":"godot-welcome-1"}).ok, "corrupt test backup produced")
	var target := normal._path
	normal.release()
	_write(target, "{BROKEN SAVE ORIGINAL}")
	var damaged := GameStore.new(dir + "-corrupt")
	var loaded := damaged.load_slot()
	check(not loaded.ok and damaged.corruption, "bad save visibly protected")
	check(not damaged.transact("summon", {"count":1}).ok, "bad save refuses mutation")
	check(FileAccess.get_file_as_string(target) == "{BROKEN SAVE ORIGINAL}", "bad save exact bytes retained")
	check(damaged.restore_backup().ok, "actual backup recovery works")
	check(GameEconomy.validate_state(damaged.state).is_empty(), "recovered save validates")
	damaged.release()
	var report := {"label":"PRE-AUDIT ONLY; not one of four completed-content rounds" if audit_phase == "preaudit" else audit_phase + " independent recovery regression", "utc":Time.get_datetime_string_from_system(true), "checks":checks, "failures":failures, "observations":observations}
	_write("res://docs/audits/%s-independent.json" % audit_phase, JSON.stringify(report, "  "))
	print(JSON.stringify(report))
	quit(0 if failures.is_empty() else 1)

func _demo_clock_and_account_import(dir: String) -> void:
	var demo := GameStore.new(dir + "-demo")
	check(demo.load_slot("demo:roster").ok, "isolated demo clock slot")
	check(demo.advance_demo_time(1800000).ok, "advance demo first interval")
	check(demo.advance_demo_time(1800000).ok, "advance demo second interval")
	check(demo.restore_backup().ok, "restore prior demo interval")
	check(demo.clock_offset == int(demo.state.get("godotDemoClockOffset",0)), "restored demo clock offset matches restored durable state")
	observations.append({"case":"demo_restore_clock", "memory_offset":demo.clock_offset, "saved_offset":demo.state.get("godotDemoClockOffset",0)})
	var mock := GameStore.new(dir + "-paid")
	check(mock.load_mock_profile("normal","payer","device").ok, "paid mock test slot")
	var service := GameOnlineMock.new((dir + "-paid").path_join("service.json"))
	check(service.command("payer","device","login").ok, "paid mock service login")
	var order := service.command("payer","device","payment_create",{"sku":"test_small","request_id":"paid-save-test"})
	check(order.ok,"paid mock order")
	var receipt := service.command("payer","device","payment_settle",{"order_id":order.data.id,"outcome":"paid"})
	check(mock.redeem_mock_receipt(receipt.data,service).ok,"canonical receipt test")
	var export_path := (dir + "-paid").path_join("paid-export.json")
	check(mock.export_save(export_path).ok,"export paid mock snapshot")
	var result := demo.import_save(export_path)
	var disk := GameStore.decode_save(FileAccess.get_file_as_string(demo._path))
	check(disk.ok,"import into demo must never write unreadable state after realm stamping")
	observations.append({"case":"paid_mock_import_into_demo","result":result,"disk_decode":disk.get("error", "ok")})
	mock.release()
	demo.release()
