extends SceneTree
var checks = 0
var failures = []
func check(condition: bool, message: String) -> void:
	checks += 1
	if not condition:
		failures.append(message)
		push_error(message)
func action(s: Dictionary, name: String, args: Dictionary = {}, now: int = -1) -> Variant:
	if now < 0: now = int(s.lastTime)
	var result = GameEconomy.command(s, name, args, now)
	check(result.ok, name + ": " + result.error)
	if result.ok: check(GameEconomy.validate_state(s).is_empty(), name + " valid: " + GameEconomy.validate_state(s))
	return result.data
func rejected(s: Dictionary, name: String, args: Dictionary = {}, now: int = -1) -> void:
	if now < 0: now = int(s.lastTime)
	var before = JSON.stringify(s)
	var result = GameEconomy.command(s, name, args, now)
	check(not result.ok, name + " must reject")
	check(JSON.stringify(s) == before, name + " rollback")
func _initialize() -> void:
	var s = GameEconomy.create_state(1700000000000)
	check(s.resources.ticket == 12 and s.owned.size() == 3, "new save defaults")
	check(GameEconomy.get_building_types().size() == 10 and GameEconomy.get_all_plots().size() == 24, "expanded content")
	check(GameData.content("CHARACTERS").size() == 50, "full roster")
	var before = s.duplicate(true)
	rejected(s, "summon", {"count": 100})
	rejected(s, "summon", {"count": 10, "rng": func(): return -1.0})
	s.resources.ticket = 100
	var never_divine = func(): return 0.99
	for i in range(89):
		var result = action(s, "summon", {"count": 1, "rng": never_divine, "txid": "pity-%d" % i})
		check(result[0].rarity == ("immortal" if (i + 1) % 10 == 0 else "mortal"), "three-tier guarantee chain")
	check(s.pity == 89, "pity89")
	var twentieth = action(s, "summon", {"count": 1, "rng": never_divine, "txid": "pity-90"})
	check(twentieth[0].rarity == "divine" and s.pity == 0, "pity90 guaranteed")
	var after = JSON.stringify(s)
	action(s, "summon", {"count": 10, "txid": "pity-90"})
	check(JSON.stringify(s) == after, "summon idempotent")
	s = before.duplicate(true)
	s.resources.ticket = 9
	rejected(s, "summon", {"count": 10})
	s = before.duplicate(true)
	var funds = s.resources.duplicate(true)
	action(s, "upgradeCharacter", {"id": "nezha"})
	action(s, "upgradeCharacter", {"id": "nezha"})
	action(s, "switchBranch", {"id": "nezha", "branch": "B"})
	action(s, "resetCharacter", {"id": "nezha"})
	check(s.resources == funds and s.owned.nezha.branch == "B" and "nezha" in s.branchUnlocks, "full refund and branch retention")
	action(s, "switchBranch", {"id": "nezha", "branch": "A"})
	action(s, "resetCharacter", {"id": "nezha"})
	check(s.resources == funds, "no repeated refund")
	s = before.duplicate(true)
	GameEconomy.advance(s, int(s.lastTime) + 1800000)
	check(s.warehouse.resources.xp == 600 and s.resources.xp == 700, "30min production awaits claim")
	action(s, "harvest")
	check(s.resources.xp == 1300, "harvest once")
	action(s, "harvest")
	check(s.resources.xp == 1300, "harvest no repeat")
	var current = int(s.lastTime)
	GameEconomy.advance(s, current + 86400000)
	check(s.warehouse.resources.xp == 4000 and s.lastTime == current + 86400000, "12h cap and full warehouse")
	var snapshot = s.warehouse.duplicate(true)
	GameEconomy.advance(s, current)
	check(s.warehouse == snapshot and s.clockWarnings == 1, "rollback clock no earning")
	s = before.duplicate(true)
	var farm = action(s, "build", {"type": "farm", "plot": "p2"})
	check(farm.readyAt > s.lastTime, "construction actual timer")
	rejected(s, "build", {"type": "farm", "plot": "p2"})
	action(s, "accelerateBuilding", {"id": farm.id})
	action(s, "assign", {"id": farm.id, "characterId": "bigan"})
	check(GameEconomy.production_bonus(s, GameEconomy.building(s, farm.id)).multiplier > 1.2, "nourishment + staff")
	var alchemy = action(s, "build", {"type": "alchemy", "plot": "p3"})
	action(s, "accelerateBuilding", {"id": alchemy.id})
	var job = action(s, "queueRecipe", {"id": alchemy.id, "recipeId": "ward"})
	var promised = job.duplicate(true)
	action(s, "assign", {"id": alchemy.id, "characterId": "nezha"})
	check(GameEconomy.building(s, alchemy.id).queue[0] == promised, "staff keeps committed job")
	action(s, "expandPlot", {"plot": "p9"})
	action(s, "moveBuilding", {"id": alchemy.id, "plot": "p9"})
	check(GameEconomy.building(s, alchemy.id).queue[0] == promised, "move keeps queue")
	action(s, "cancelQueue", {"id": alchemy.id, "jobId": job.id})
	check(GameEconomy.building(s, alchemy.id).queue.is_empty(), "cancel actual job")
	job = action(s, "queueRecipe", {"id": alchemy.id, "recipeId": "ward"})
	action(s, "advance", {}, int(job.readyAt))
	rejected(s, "cancelQueue", {"id": alchemy.id, "jobId": job.id})
	check(s.items.get("ward", 0) == 0 and s.warehouse.items.ward == 1, "production warehouse")
	action(s, "harvestBuilding", {"id": alchemy.id})
	check(s.items.ward == 1, "per building claim")
	for stage in range(1, 13):
		action(s, "settleVictory", {"battleId": "test-%d" % stage, "stageId": stage})
		if stage == 3: action(s, "chooseGift", {"id": "yangjian"})
		if stage % 4 == 0: action(s, "integrateCore", {"id": "spring" if stage == 4 else "furnace" if stage == 8 else "thunder"})
	check(s.slots == 5 and s.cleared.size() == 12 and s.integratedCores.size() == 3, "full progression gates")
	action(s, "startMaterialSweep", {"stageId": 1})
	rejected(s, "claimMaterialSweep", {}, int(s.lastTime) + 59999)
	action(s, "claimMaterialSweep", {}, int(s.lastTime) + 60000)
	rejected(s, "claimMaterialSweep")
	rejected(s, "startMaterialSweep", {"stageId": 4})
	action(s, "claimCheckIn")
	rejected(s, "claimCheckIn")
	for day in range(1, 8):
		action(s, "claimCheckIn", {}, int(s.lastTime) + 86400000)
	check(s.checkIn.total == 8, "7day cumulative checkin cycle")
	rejected(s, "claimCheckIn", {}, int(s.lastTime) - 86400000)
	action(s, "claimMail", {"id": "godot-welcome-1"})
	rejected(s, "claimMail", {"id": "godot-welcome-1"})
	for preset in GameData.all().demoStates:
		var demo = GameEconomy.demo_state(preset, 1700000000000)
		check(demo.demo == preset and demo.daily.progress.estate == 0, "demo preserved isolated")
		check(GameEconomy.validate_state(demo).is_empty(), "demo validation " + preset + ": " + GameEconomy.validate_state(demo))
	_test_extended_economy()
	_test_validation_and_migration()
	_test_missions_shop_challenges()
	_test_challenge_resume_snapshot()
	_test_extension_snapshot_reload()
	print("ECONOMY CHECKS: %d, FAILURES: %d" % [checks, failures.size()])
	quit(0 if failures.is_empty() else 1)

func _test_extended_economy() -> void:
	# A pre-expansion unit fixture, deliberately distinct from the now fully
	# expanded player-facing C3 review preset. Actual commands build everything.
	var s: Dictionary = GameData.all().demoStates["estate-complete"].duplicate(true)
	s.createdAt = 1700000000000
	s.lastTime = 1700000000000
	GameEconomy.ensure_extensions(s)
	var base = GameEconomy.warehouse_capacity(s)
	for plot in ["p9", "p10", "p11", "p12"]: action(s, "expandPlot", {"plot": plot})
	rejected(s, "expandPlot", {"plot": "p9"})
	var warehouse = action(s, "build", {"type": "warehouse", "plot": "p9"})
	check(GameEconomy.warehouse_capacity(s) == base, "warehouse construction grants no premature capacity")
	action(s, "advance", {}, int(warehouse.readyAt))
	check(GameEconomy.warehouse_capacity(s) == base + 2000, "warehouse actual capacity upgrade")
	action(s, "upgradeBuilding", {"id": warehouse.id})
	check(GameEconomy.warehouse_capacity(s) == base + 2000, "warehouse existing capacity preserved through upgrade")
	action(s, "advance", {}, int(GameEconomy.building(s, warehouse.id).readyAt))
	check(GameEconomy.warehouse_capacity(s) == base + 4000, "level2 warehouse capacity")
	var mine = action(s, "build", {"type": "mine", "plot": "p12"})
	action(s, "advance", {}, int(mine.readyAt))
	var stone = s.resources.stone
	action(s, "advance", {}, int(s.lastTime) + 60000)
	check(s.warehouse.sources[mine.id].resources.stone == 12, "mine real 12stone perminute")
	action(s, "harvestBuilding", {"id": mine.id})
	check(s.resources.stone == stone + 12, "mine stone requires claim")
	action(s, "expandPlot", {"plot": "p13"})
	var workshop = action(s, "build", {"type": "relicworkshop", "plot": "p13"})
	action(s, "advance", {}, int(workshop.readyAt))
	var job = action(s, "queueRecipe", {"id": workshop.id, "recipeId": "relic-essence"})
	action(s, "advance", {}, int(job.readyAt))
	check(s.items.get("relic-essence", 0) == 0 and s.warehouse.items["relic-essence"] == 2, "workshop real paid queue")
	action(s, "harvestBuilding", {"id": workshop.id})
	check(s.items["relic-essence"] == 2, "workshop essence usable bag")
	action(s, "claimActivity", {"id": "settlement-builder"})
	rejected(s, "claimActivity", {"id": "settlement-builder"})
	var frozen = JSON.stringify(s)
	GameEconomy.daily_task_status(s, int(s.lastTime) + 86400000)
	GameEconomy.check_in_status(s, int(s.lastTime) + 86400000)
	GameEconomy.activity_status(s)
	GameEconomy.get_building_statuses(s)
	check(JSON.stringify(s) == frozen, "presentation queries pure")

func _test_validation_and_migration() -> void:
	var original = GameEconomy.create_state(1700000000000)
	check(GameEconomy.validate_state(original).is_empty(), "new save valid")
	for patch in [{"resources": {}}, {"owned": []}, {"team": ["nezha", "nezha"]}, {"buildings": []}, {"warehouse": {}}, {"daily": {}}, {"randomStreams": {"summon": 0}}, {"mainBattle": {}}, {"materialSweep": {}}, {"thunderProject": {}}, {"checkIn": {"total": 2, "claimedDays": ["2026-01-01"]}}]:
		var corrupt = original.duplicate(true)
		corrupt.merge(patch, true)
		check(not GameEconomy.validate_state(corrupt).is_empty(), "corrupt shape rejected " + str(patch.keys()))
	var old = original.duplicate(true)
	old.version = 1
	for key in ["schemaRevision", "randomStreams", "branchUnlocks", "daily", "materialSweep", "mainBattle", "demo", "expandedPlots", "checkIn", "claimedMail", "claimedActivities", "equipment"]: old.erase(key)
	old.owned.nezha.level = 4
	old.owned.nezha.erase("spent")
	old.warehouse.erase("sources")
	old.warehouse.erase("repairs")
	var raw = JSON.stringify(old)
	var migrated = GameEconomy.migrate_state(old, 1)
	check(not migrated.has("error"), "legacy V1 migrates")
	check(JSON.stringify(old) == raw, "migration preserves original input")
	check(migrated.owned.nezha.spent == {"stone": 195, "xp": 150}, "frozen old investment curve")
	check(migrated.resources.ticket == 12 and migrated.owned.size() == 3 and migrated.daily.progress.estate == 0, "migration no reissued assets/daily")
	check(GameEconomy.validate_state(migrated).is_empty(), "migrated validates")
	var old_current = original.duplicate(true)
	old_current.erase("schemaRevision")
	old_current.buildings.append({"id": "farm-old", "type": "farm", "plot": "missing", "level": 2, "readyAt": 0, "queue": [], "assigned": "nezha", "progress": 0.4})
	migrated = GameEconomy.migrate_state(old_current, 3)
	check(not migrated.has("error") and GameEconomy.building(migrated, "farm-old").plot == "p2", "deterministic placement migration")

func _test_missions_shop_challenges() -> void:
	var s = GameEconomy.demo_state("expedition-project", 1700000000000)
	var mission = action(s, "startIdleMission", {"missionId": "herb-gathering", "characters": ["nezha"]})
	rejected(s, "startIdleMission", {"missionId": "herb-gathering", "characters": ["nezha"]})
	rejected(s, "claimIdleMission", {"id": mission.id}, int(mission.readyAt) - 1)
	var herbs = s.resources.herb
	action(s, "claimIdleMission", {"id": mission.id}, int(mission.readyAt))
	check(s.resources.herb == herbs + 12, "timed mission exact reward")
	rejected(s, "claimIdleMission", {"id": mission.id})
	var essence_before = s.items.get("relic-essence",0)
	mission = action(s, "startIdleMission", {"missionId": "long-cultivation", "characters": ["bigan"]})
	check(mission.readyAt - mission.startedAt == 43200000, "offline mission max12h")
	action(s, "claimIdleMission", {"id": mission.id}, int(mission.readyAt) + 43200000)
	check(s.items["relic-essence"] == essence_before + 12, "late mission claim one reward only")
	action(s, "buyShopItem", {"id": "xp-scroll", "count": 5})
	rejected(s, "buyShopItem", {"id": "xp-scroll"})
	var xp = s.resources.xp
	action(s, "useItem", {"id": "xp-scroll", "count": 5})
	check(s.resources.xp == xp + 750 and s.items["xp-scroll"] == 0, "use consumable actual xp")
	rejected(s, "useItem", {"id": "xp-scroll"})
	rejected(s, "useItem", {"id": "ward"})
	var req = action(s, "prepareCharacterChallenge", {"characterId": "nezha", "tier": 1})
	var b = GameCombat.create(req.stageId, req.team, req.options)
	var actions = 0
	while b.result == null and actions < 2000:
		GameCombat.auto_act(b)
		actions += 1
	check(b.result == "win", "real character challenge battle")
	var clears = s.cleared.duplicate()
	var stone = s.resources.stone
	var gear_before = s.equipment.items.size()
	var result = action(s, "settleCharacterChallenge", {"battle": b})
	check(result.won and s.cleared == clears and s.resources.stone == stone + 100, "challenge own reward not mainline reward")
	check(s.equipment.items.size() == gear_before + 1, "character challenge actual loot")
	rejected(s, "prepareCharacterChallenge", {"characterId": "nezha", "tier": 1})
	rejected(s, "settleCharacterChallenge", {"battle": b})
	var player = GameEconomy.create_state(1700000000000)
	rejected(player, "redeemMockReceipt", {"receipt_id": "fake", "account": "x", "realm": "local", "rewards": {"ticket": 10}})

func _test_challenge_resume_snapshot() -> void:
	var s = GameEconomy.demo_state("expedition-project", 1700000000000)
	action(s, "selectPill", {"id": "ward"})
	var before_pills = s.items.ward
	var request = action(s, "prepareCharacterChallenge", {"characterId": "nezha", "tier": 1})
	check(s.items.ward == before_pills - 1, "challenge initial admission charges one pill")
	var locked = s.characterChallenges.active.duplicate(true)
	action(s, "resetCharacter", {"id": "nezha"})
	action(s, "setTeam", {"ids": ["bigan"]})
	action(s, "selectPill", {"id": "heal"})
	check(s.owned.nezha.level == 1 and not "nezha" in s.team, "resume regression changes both admission gates")
	var resumed = action(s, "prepareCharacterChallenge", {"characterId": "nezha", "tier": 1})
	check(resumed == request and s.characterChallenges.active == locked, "resume retains locked team level method pill and seed")
	check(s.items.ward == before_pills - 1 and s.items.heal == 9, "resume never charges another or alternate pill")
	rejected(s, "prepareCharacterChallenge", {"characterId": "bigan", "tier": 1})
	rejected(s, "prepareCharacterChallenge", {"characterId": "nezha", "tier": 2})
	s = GameData.normalize(JSON.parse_string(JSON.stringify(s, "", false, true)))
	resumed = action(s, "prepareCharacterChallenge", {"characterId": "nezha", "tier": 1})
	check(GameData.normalize(resumed) == GameData.normalize(request), "saved snapshot resumes after JSON reload and roster reset")
	var b = GameCombat.create(resumed.stageId, resumed.team, resumed.options)
	var count = 0
	while b.result == null and count < 2000:
		GameCombat.auto_act(b)
		count += 1
	check(b.result == "win", "resumed locked party wins actual battle")
	var result = action(s, "settleCharacterChallenge", {"battle": b})
	check(result.won and s.characterChallenges.active == null and "nezha:1" in s.characterChallenges.claimed, "resumed challenge settles normally")
	check(s.owned.nezha.level == 1 and s.team == ["bigan"], "snapshot battle never overwrites current training or roster")

func _test_extension_snapshot_reload() -> void:
	var s = GameEconomy.demo_state("expedition-project", 1700000000000)
	action(s, "expandPlot", {"plot": "p12"})
	var workshop = action(s, "build", {"type": "relicworkshop", "plot": "p12"})
	action(s, "advance", {}, int(workshop.readyAt))
	action(s, "queueRecipe", {"id": workshop.id, "recipeId": "relic-essence"})
	action(s, "startIdleMission", {"missionId": "long-cultivation", "characters": ["bigan"]})
	action(s, "prepareCharacterChallenge", {"characterId": "nezha", "tier": 1})
	var decoded = GameStore.decode_save(GameStore.encode_save(s))
	check(decoded.ok, "native reload validates simultaneous workshop mission and challenge snapshots")
	if decoded.ok:
		check(decoded.data == GameData.normalize(s.duplicate(true)), "native extension snapshot amounts and promises unchanged")
		check(GameEconomy.validate_state(decoded.data).is_empty(), "decoded extension ledgers validate")
