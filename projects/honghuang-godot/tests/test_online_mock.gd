extends SceneTree
const Mock = preload("res://scripts/game_online_mock.gd")
var checks = 0
var failures: Array = []
func check(value: bool, label: String) -> void:
	checks += 1
	if not value:
		failures.append(label)
		push_error(label)
func call_ok(m, a: String, d: String, op: String, args: Dictionary = {}) -> Variant:
	var r = m.command(a, d, op, args)
	check(r.ok, op + " " + str(r.error))
	return r.data
func reject(m, a: String, d: String, op: String, args: Dictionary = {}) -> void:
	var before = JSON.stringify(m.snapshot())
	var r = m.command(a, d, op, args)
	check(not r.ok, op + " rejected")
	check(JSON.stringify(m.snapshot()) == before, op + " rollback")
func _initialize() -> void:
	var folder = "user://tests/mock_" + str(Time.get_ticks_usec())
	var path = folder.path_join("service.json")
	var m = Mock.new(path)
	check(m.load_data().ok, "new service")
	reject(m, "a", "d1", "cloud_download")
	reject(m, "../bad", "d1", "login")
	call_ok(m, "a", "d1", "login", {"nickname": "测试甲"})
	call_ok(m, "b", "d1", "login", {"nickname": "测试乙"})
	call_ok(m, "a", "d2", "login")
	var save = {"version": 3, "demo": null, "resources": {"gold": 7}}
	var cloud = call_ok(m, "a", "d1", "cloud_upload", {"save": save, "expected_revision": 0})
	check(cloud.revision == 1, "cloud initial revision")
	save.resources.gold = 999
	check(call_ok(m, "a", "d2", "cloud_download").save.resources.gold == 7, "cloud copy isolation and device download")
	check(call_ok(m, "b", "d1", "cloud_download").is_empty(), "account clouds isolated")
	reject(m, "a", "d2", "cloud_upload", {"save": save, "expected_revision": 0})
	reject(m, "a", "d2", "cloud_upload", {"save": {"demo": "A"}, "expected_revision": 1})
	call_ok(m, "a", "d2", "cloud_upload", {"save": save, "expected_revision": 1})
	check(call_ok(m, "a", "d1", "cloud_download").revision == 2, "explicit resolved upload")
	call_ok(m, "a", "d1", "chat_send", {"text": "甲发言", "request_id": "r1"})
	call_ok(m, "a", "d1", "chat_send", {"text": "甲发言", "request_id": "r1"})
	check(call_ok(m, "b", "d1", "chat_history").size() == 1, "chat retry dedup")
	reject(m, "a", "d1", "chat_send", {"text": "\n"})
	reject(m, "a", "d1", "chat_send", {"text": "a".repeat(201)})
	var guild = call_ok(m, "a", "d1", "guild_create", {"name": "测试仙盟"})
	reject(m, "b", "d1", "chat_history", {"channel": "guild:" + guild.id})
	call_ok(m, "b", "d1", "guild_join", {"guild_id": guild.id})
	call_ok(m, "a", "d1", "chat_send", {"channel": "guild", "text": "仅盟友可读"})
	check(call_ok(m, "b", "d1", "chat_history", {"channel": "guild"}).size() == 1, "guild message visible members")
	reject(m, "a", "d1", "guild_leave")
	call_ok(m, "a", "d1", "guild_leave", {"successor_id": "b"})
	check(call_ok(m, "b", "d1", "guild_info").owner == "b", "owner transfer")
	reject(m, "a", "d1", "chat_history", {"channel": "guild"})
	call_ok(m, "b", "d1", "guild_leave")
	check(call_ok(m, "a", "d1", "guild_list").is_empty(), "empty guild removed")
	call_ok(m, "b", "d1", "rank_submit", {"score": 100})
	call_ok(m, "a", "d1", "rank_submit", {"score": 100})
	check(call_ok(m, "a", "d1", "rank_list")[0].account == "a", "rank tie deterministic")
	call_ok(m, "b", "d1", "rank_submit", {"score": 101})
	check(call_ok(m, "a", "d1", "rank_list")[0].account == "b", "rank updates")
	reject(m, "a", "d1", "rank_submit", {"score": -1})
	var order = call_ok(m, "a", "d1", "payment_create", {"sku": "test_small", "request_id": "buy1"})
	check(order.real_payment == false and order.status == "pending", "never real payment")
	check(call_ok(m, "a", "d1", "payment_create", {"sku": "test_small", "request_id": "buy1"}).id == order.id, "order idempotent")
	reject(m, "a", "d1", "payment_create", {"sku": "test_large", "request_id": "buy1"})
	reject(m, "b", "d1", "payment_settle", {"order_id": order.id, "outcome": "paid"})
	var paid = call_ok(m, "a", "d1", "payment_settle", {"order_id": order.id, "outcome": "paid"})
	check(paid.receipt_id.begins_with("mock:normal:a:"), "receipt account scoped")
	check(call_ok(m, "a", "d1", "payment_settle", {"order_id": order.id, "outcome": "paid"}) == paid, "callback idempotent")
	reject(m, "a", "d1", "payment_settle", {"order_id": order.id, "outcome": "cancelled"})
	check(call_ok(m, "a", "d1", "payment_receipts").size() == 1, "one paid receipt")
	var cancel = call_ok(m, "a", "d1", "payment_create", {"sku": "test_small", "request_id": "buy2"})
	call_ok(m, "a", "d1", "payment_settle", {"order_id": cancel.id, "outcome": "cancelled"})
	reject(m, "a", "d1", "payment_settle", {"order_id": cancel.id, "outcome": "paid"})
	check(call_ok(m, "a", "d1", "payment_receipts").size() == 1, "cancel never credited")
	m.offline = true
	reject(m, "a", "d1", "chat_send", {"text": "离线"})
	m.offline = false
	m.fail_writes = true
	reject(m, "a", "d1", "chat_send", {"text": "写失败"})
	m.fail_writes = false
	var other = Mock.new(path)
	check(other.load_data().ok, "reload store")
	check(call_ok(other, "a", "d1", "payment_receipts").size() == 1, "receipts survive reload")
	call_ok(other, "a", "d1", "chat_send", {"text": "新版本"})
	reject(m, "a", "d1", "chat_send", {"text": "旧窗口不能覆盖"})
	check(m.load_data().ok, "refresh stale state")
	var demo = Mock.new(path, "demo:A")
	call_ok(demo, "a", "d1", "login")
	check(call_ok(demo, "a", "d1", "cloud_download").is_empty(), "demo cloud isolated")
	check(call_ok(demo, "a", "d1", "payment_receipts").is_empty(), "demo receipts isolated")
	reject(demo, "a", "d1", "cloud_upload", {"save": save, "expected_revision": 0})
	call_ok(demo, "a", "d1", "cloud_upload", {"save": {"demo": "A", "gold": 999}, "expected_revision": 0})
	var corrupt_path = folder.path_join("corrupt.json")
	var f = FileAccess.open(corrupt_path, FileAccess.WRITE)
	f.store_string("broken")
	f.close()
	var corrupt = Mock.new(corrupt_path)
	check(not corrupt.load_data().ok, "corrupt protected")
	reject(corrupt, "a", "d1", "login")
	check(FileAccess.get_file_as_string(corrupt_path) == "broken", "corrupt raw preserved")
	print(JSON.stringify({"suite": "online_mock", "checks": checks, "failures": failures}))
	quit(0 if failures.is_empty() else 1)
