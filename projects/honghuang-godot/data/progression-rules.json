  "stories": {
    "nezha": [
      {
        "title": "莲塘访客",
        "text": "哪吒在新莲旁收起火尖枪：真正的勇敢，是承认自己也会犯错。你与他一起扶正被风吹斜的幼苗。",
        "gift": "cloud"
      },
      {
        "title": "送还木鸢",
        "text": "哪吒将修好的木鸢交还山下孩童。他没有留下姓名，只邀你明日再来试飞。"
      }
    ],
    "bigan": [
      {
        "title": "一盏灯火",
        "text": "比干展开发黄的田册，逐户记下缺粮的人家。你添亮灯火，与他把账核到深夜。",
        "gift": "cloud"
      },
      {
        "title": "桥头问答",
        "text": "桥头的少年问何为公正。比干让众人先听完彼此的难处，再决定如何分配新修的水渠。"
      }
    ],
    "yangjian": [
      {
        "title": "山道微雨",
        "text": "杨戬拾起旅人散落的草药，哮天犬替你们守着湿滑的山道。他说，远行先看脚下。",
        "gift": "cloud"
      },
      {
        "title": "静夜归途",
        "text": "巡山归来，他将最后一碗热汤留给值夜弟子。仙府的灯一盏接一盏亮起。"
      }
    ]
  }
}
